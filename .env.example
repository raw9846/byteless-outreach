ANTHROPIC_API_KEY=your_key_here
PAGESPEED_API_KEY=optional_for_higher_quota

# Apollo Organization Enrichment API — fetches firmographic company data
# (industry, employee count, revenue, funding, tech stack) by domain.
# Requires an Apollo plan with API access enabled.
APOLLO_API_KEY=your_apollo_api_key

# Which AI CLI to shell out to for analysis/email writing: "claude" or "codex".
# Leave unset to auto-detect whichever one is installed.
AI_BACKEND=claude
# Only needed if AI_BACKEND=codex and you're not using `codex login`
CODEX_API_KEY=optional_if_using_codex_login

# Direct Google Sheets API access (bypasses the MCP connector / preview-program
# gate). Same OAuth client as the "Claude Audit Workspace" connector setup —
# reuse its client ID/secret here. Run `python3 main.py sheets-auth` once
# after setting these to authorize and cache a token.
GOOGLE_SHEETS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_SHEETS_CLIENT_SECRET=your_client_secret
